## 5. Custom Guards

You can build custom guards for any arbitrary logic—such as IP rate limiting, geo-fencing, maintenance mode checks, or feature flags.

### Example: Maintenance Mode Guard

```typescript
// maintenance.guard.ts
import { Injectable, CanActivate, ExecutionContext, ServiceUnavailableException } from '@nestjs/common';

@Injectable()
export class MaintenanceGuard implements CanActivate {
  canActivate(context: ExecutionContext): boolean {
    const isUnderMaintenance = false; // Fetch from a config or database service

    if (isUnderMaintenance) {
      throw new ServiceUnavailableException('The application is currently under maintenance.');
    }

    return true;
  }
}

```