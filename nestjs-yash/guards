## 2. Authentication Guards

Authentication guards verify *who* the user is, typically by validating a JSON Web Token (JWT), API key, or session cookie attached to the incoming request. If verification fails, the guard throws an unauthorized exception (e.g., `UnauthorizedException`), stopping the request lifecycle.

```typescript
// jwt-auth.guard.ts
import { Injectable, CanActivate, ExecutionContext, UnauthorizedException } from '@nestjs/common';

@Injectable()
export class JwtAuthGuard implements CanActivate {
  canActivate(context: ExecutionContext): boolean {
    const request = context.switchToHttp().getRequest();
    const token = request.headers.authorization;

    if (!token) {
      throw new UnauthorizedException('No token provided');
    }

    // Verify token logic here...
    return true; 
  }
}

```

