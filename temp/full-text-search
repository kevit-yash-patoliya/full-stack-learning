    id,
    name,
    description,
    categories,
    ts_rank(
        search_vector,
        to_tsquery('english', 'database')
    ) AS rank
FROM products
WHERE search_vector @@ to_tsquery('english', 'open & database & relational')
ORDER BY rank DESC;

create table orders(
	id serial primary key,
	product_id int,
	amount decimal(10,5),
	price int,
	quantity int,
	constraint FK_PRODUCT_ID foreign key (product_id) references products(id)
)

alter table orders 
add column search_vector tsvector;


create or replace function trigger_on_order()
returns trigger
language plpgsql
as 
$$
begin 
	NEW.search_vector := 
		to_tsvector('english',coalesce(NEW.price::text,''));
	return NEW;
end$$;

create trigger trigger_order
before insert or update of price
on orders
for each row
execute function trigger_on_order();

